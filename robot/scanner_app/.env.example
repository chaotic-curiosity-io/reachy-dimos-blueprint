# Copy to .env and fill in for local development. The robot reads these from
# its own environment at app launch time. The in-app settings page at
# http://<robot>:8042/ lets you change any of these at runtime.

# Bridge connection: the LAN IP of your station (the Mac or DGX running the
# bridge in ../../station/). No default -- the app idles until this is set.
DIMOS_SCANNER_BRIDGE_HOST=<station-ip>
DIMOS_SCANNER_BRIDGE_PORT=9876

# Streaming
DIMOS_SCANNER_JPEG_QUALITY=80
DIMOS_SCANNER_FRAME_HZ=5

# Depth model preference sent to the Mac dimos pipeline in the WS hello.
# Allowed: da3-small | da3-base | da3-large | da3metric-large | depthpro
DIMOS_SCANNER_DEPTH_MODEL=da3-small

# In-app settings page (FastAPI). Set DIMOS_SCANNER_SETTINGS_URL="" to disable.
DIMOS_SCANNER_SETTINGS_URL=http://0.0.0.0:8042
